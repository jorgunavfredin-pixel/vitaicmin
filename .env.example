# ==============================================
# VITAICMIN — Environment Configuration Example
# Salin menjadi .env lalu isi nilai sebenarnya.
# JANGAN commit file .env atau credential asli.
# ==============================================

# ---- Wajib: Telegram & server ----
BOT_TOKEN=1234567890:REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_ID=123456789
PORT=3000

# URL publik bot tanpa trailing slash.
# Untuk produksi, gunakan domain HTTPS yang mengarah ke PORT di atas.
# Callback PaKasir  : ${WEBHOOK_URL}/webhook/qris
# Callback WijayaPay: ${WEBHOOK_URL}/webhook/wijayapay
# Callback Xoftware : ${WEBHOOK_URL}/webhook/xoftware
# Callback KlikQRIS : ${WEBHOOK_URL}/webhook/klikqris
WEBHOOK_URL=https://store.example.com

# ---- Identitas toko ----
STORE_NAME=Vitaicmin Store
ORDER_PREFIX=VTC

# ---- Customer Support ----
# Telegram Admin wajib diisi saat deployment awal. Yang lain opsional.
# Nilai yang disimpan lewat Admin Web menjadi prioritas dan langsung aktif tanpa restart.
SUPPORT_TELEGRAM_URL=https://t.me/username_admin
SUPPORT_WHATSAPP_URL=
SUPPORT_GROUP_URL=
SUPPORT_CHANNEL_URL=
SUPPORT_TEXT=

# Legacy fallback untuk tenant lama (opsional; gunakan URL di atas untuk deployment baru).
SUPPORT_USERNAME=
SUPPORT_HOURS=

# ---- Fitur restart-bound ----
# true = tampilkan menu Sewa Bot; false/kosong = sembunyikan.
# Hanya dibaca dari .env saat proses berjalan, jadi perubahan wajib restart/recreate.
RENT_BOT_ENABLED=false

# ---- Access Gate buyer (restart-bound, opsional) ----
# Kosong/off = nonaktif; join = wajib join; approval = wajib persetujuan admin.
# Mode join: isi channel atau group, atau keduanya. Setiap target wajib punya ID + URL.
ACCESS_GATE_MODE=
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=
REQUIRED_GROUP_ID=
REQUIRED_GROUP_URL=

# ---- Web admin ----
# Login panel: ${WEBHOOK_URL}/admin
ADMIN_PANEL_PASSWORD=replace-with-a-strong-password

# Opsional. Jika kosong, sistem otomatis membuat secret acak persisten di database.
# Jika diisi manual, gunakan string acak panjang dan JANGAN samakan dengan BOT_TOKEN.
# Contoh generate: openssl rand -hex 32
ADMIN_JWT_SECRET=

# ---- Payment Gateway: PaKasir (opsional) ----
# Bisa dikonfigurasi melalui .env ATAU web admin panel.
PAKASIR_API_KEY=
PAKASIR_SLUG=

# ---- Payment Gateway: WijayaPay (opsional) ----
# Hanya channel QRIS yang digunakan; VA/retail diabaikan.
# Isi kedua field secara berpasangan, atau konfigurasi melalui web admin panel.
# Atur callback_url ke ${WEBHOOK_URL}/webhook/wijayapay.
# Dokumentasi WijayaPay menyebut callback berasal dari IP 45.158.126.118;
# whitelist IP tersebut pada firewall/proxy callback bila pembatasan IP diterapkan.
WIJAYAPAY_CODE_MERCHANT=
WIJAYAPAY_API_KEY=

# ---- Payment Gateway: Xoftware Pay (opsional) ----
# API production: https://payment.xoftware.id
# Callback: ${WEBHOOK_URL}/webhook/xoftware
# Xoftware menerima expiry toko secara native lewat expires_in_minutes.
XOWFTWARE_API_KEY=
XOWFTWARE_MERCHANT_ID=
XOWFTWARE_WEBHOOK_SECRET=
# Wajib exact-match dengan URL yang di-approve Xoftware (boleh URL t.me bot).
# Polling otomatis tetap mendeteksi paid jika URL ini bukan endpoint webhook backend.
XOWFTWARE_NOTIFY_URL=
# merchant = fee dipotong settlement; user = fee ditambahkan ke tagihan buyer
XOWFTWARE_FEE_DIRECTION=merchant

# ---- Payment Gateway: KlikQRIS (opsional) ----
# API production: https://klikqris.com
# Create : POST /api/qrisv2/create
# Status : GET  /api/qris/status/{order_id}
# Callback: ${WEBHOOK_URL}/webhook/klikqris
# Catatan: pastikan akun merchant sudah diaktifkan "MY PG mode" oleh KlikQRIS,
#          jika tidak create akan ditolak 403 (MY PG mode is not allowed).
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=
