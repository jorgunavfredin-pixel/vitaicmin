# Dependencies
node_modules/

# Database (data live pelanggan — jangan di-push)
src/database/

# Assets (banner/media lokal)
# assets/ di-track tapi hanya file default yang di-commit:
# - .gitkeep (biar folder selalu ada saat clone → Docker build tidak gagal)
# - banner default toko (placeholder)
# Upload admin (banner toko, qris-custom, dll) tetap di-ignore.
assets/*
!assets/.gitkeep
!assets/banner.png

# Build output frontend
admin-web/node_modules/

# Env & secrets
.env
.env.*
!.env.example

# Logs & OS
*.log
.DS_Store
